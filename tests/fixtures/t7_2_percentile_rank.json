{
  "description": "T7.2 percentile_rank 计算 - 同方向 peer_sample 过滤 + rank 计算",
  "scenario": "3 个已终止 UP wave，计算第 4 个 UP wave 的 rank",

  "human_reasoning": {
    "peer_sample": "只包含同方向（UP）已终止 wave，按 termination_bar_dt 过滤",
    "percentile_rank_formula": "count(x_i < x) / N",
    "span_bars_example": "当前 wave span_bars=5，peer_sample=[3, 4, 6]，count(< 5)=2，rank=2/3=0.6667",
    "防前视": "只包含 termination_bar_dt <= 当前 bar_dt 的 wave",
    "最小样本量": "N < 30 时返回 None（本 fixture 只有 3 个，演示计算逻辑）"
  },

  "peer_sample_waves": [
    {
      "wave_id": "TEST_1D_w_1",
      "direction": "UP",
      "termination_bar_dt": "2024-01-10",
      "span_bars": 3,
      "price_range": 15,
      "progress_pct": 0.15,
      "stagnation": 1.0
    },
    {
      "wave_id": "TEST_1D_w_2",
      "direction": "UP",
      "termination_bar_dt": "2024-01-20",
      "span_bars": 4,
      "price_range": 20,
      "progress_pct": 0.20,
      "stagnation": 1.33
    },
    {
      "wave_id": "TEST_1D_w_3",
      "direction": "UP",
      "termination_bar_dt": "2024-01-30",
      "span_bars": 6,
      "price_range": 25,
      "progress_pct": 0.25,
      "stagnation": 2.0
    }
  ],

  "current_wave": {
    "wave_id": "TEST_1D_w_4",
    "direction": "UP",
    "termination_bar_dt": "2024-02-10",
    "span_bars": 5,
    "price_range": 23,
    "progress_pct": 0.232,
    "stagnation": 1.67,
    "note": "当前 bar_dt = 2024-02-10，peer_sample 包含前 3 个 wave"
  },

  "expected_ranks": {
    "span_rank": 0.6667,
    "span_rank_reasoning": "span_bars=5, peer=[3,4,6], count(<5)=2, rank=2/3=0.6667",

    "range_rank": 0.6667,
    "range_rank_reasoning": "price_range=23, peer=[15,20,25], count(<23)=2, rank=2/3=0.6667",

    "progress_rank": 0.6667,
    "progress_rank_reasoning": "progress_pct=0.232, peer=[0.15,0.20,0.25], count(<0.232)=2, rank=2/3=0.6667",

    "stagnation_rank": 0.3333,
    "stagnation_rank_reasoning": "stagnation=1.67, peer=[1.0,1.33,2.0], count(<1.67)=1, rank=1/3=0.3333"
  },

  "edge_cases": {
    "minimum_value": {
      "span_bars": 2,
      "peer": [3, 4, 6],
      "expected_rank": 0.0,
      "reasoning": "最小值，count(<2)=0, rank=0/3=0.0"
    },
    "maximum_value": {
      "span_bars": 7,
      "peer": [3, 4, 6],
      "expected_rank": 1.0,
      "reasoning": "最大值，count(<7)=3, rank=3/3=1.0（但规格说应该是 (N-1)/N，需确认）"
    },
    "equal_value": {
      "span_bars": 4,
      "peer": [3, 4, 6],
      "expected_rank": 0.3333,
      "reasoning": "等于样本中某值，count(<4)=1（严格<，不含=），rank=1/3=0.3333"
    }
  },

  "sample_size_constraint": {
    "N_less_than_30": "本 fixture N=3 < 30，实际应返回 None，但用于演示计算逻辑",
    "production_behavior": "N < 30 时所有 rank 字段为 None"
  }
}
